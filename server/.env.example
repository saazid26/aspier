# ==============================================================================
# ASPIER Server Configuration & Environment Variables
# ==============================================================================

# Runtime Environment
NODE_ENV=production
PORT=5000

# Fixed Superadministrator Identity
# Default: s2310956146@ru.ac.bd
ADMIN_EMAIL=s2310956146@ru.ac.bd
# Minimum 12 characters. Seeded automatically on startup if database is empty.
ADMIN_PASSWORD=replace-with-a-unique-secret-of-at-least-12-characters

# MongoDB Atlas Database URI
# e.g., mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/aspier?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/aspier?retryWrites=true&w=majority

# Web Client URL (used for CORS, Auth Cookies, and Email Links)
CLIENT_URL=https://aspier.org
# Cookie Domain (Leave empty in local dev, set to .aspier.org in production if using subdomains)
COOKIE_DOMAIN=

# Security & Encryption Keys (Minimum 32 characters / 64 hex characters)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET=replace-with-a-64-character-random-hex-string-for-access-tokens
JWT_REFRESH_SECRET=replace-with-a-64-character-random-hex-string-for-refresh-tokens
FIELD_ENC_KEY=replace-with-a-64-character-random-hex-string-for-aes-256-gcm-fields

# Cloudinary Storage (For uploaded media assets, certificates, and photos)
# Sign up at https://cloudinary.com
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Transactional Email Service (SMTP)
# Used for password resets, membership approvals, credentials dispatch, and payment confirmations
# If left blank, notifications will log gracefully to the server console and notify admins in-app.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-google-app-password
SMTP_FROM="ASPIER <no-reply@aspier.org>"
